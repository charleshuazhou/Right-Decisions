# Use one provider. If several keys are set, XAI_API_KEY wins, then OPENAI_API_KEY, then AI_API_KEY.
# With no key, readings still work from the hexagram and chart texts and say that AI is not configured.

# xAI (OpenAI-compatible)
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-3

# OpenAI, or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Generic fallback
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
